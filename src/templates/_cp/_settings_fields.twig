{# Field names here are bare — no `settings[…]` prefix. Both consumers of this partial
   apply that namespace themselves: `craft\base\Plugin::settingsResponse()` wraps the
   Settings → Plugins screen in `View::namespaceInputs(…, 'settings')`, and
   `_cp/settings.twig` wraps its include in `{% namespace 'settings' %}`.

   Writing `settings[foo]` here posts as `settings[settings][foo]`, which Craft's
   save-plugin-settings action ignores entirely — the screen looks perfect, Craft reports
   "Plugin settings saved", and every edit is silently discarded. #}
{% import '_includes/forms.twig' as forms %}

{% set ctLicense = craft.app.plugins.getPlugin('control-tower').license %}
{% if not ctLicense.getIsValid() %}
    <div class="readable">
        <blockquote class="note warning">
            <p><strong>Control Tower is locked.</strong> {{ ctLicense.getStatusMessage() }}</p>
            <p>Settings can still be saved, but tracking and dashboards stay off until the license
                is valid. <a href="{{ cpUrl('control-tower/license') }}">Manage license</a></p>
        </blockquote>
    </div>
{% endif %}

<h2>Tracking</h2>

{{ forms.lightswitchField({
    label: 'Track Visitors',
    instructions: 'Enable front-end visitor tracking via request logging.',
    id: 'trackVisitors',
    name: 'trackVisitors',
    on: settings.trackVisitors,
}) }}

{{ forms.lightswitchField({
    label: 'Track Editors',
    instructions: 'Track CP user activity (routes, element editing).',
    id: 'trackEditors',
    name: 'trackEditors',
    on: settings.trackEditors,
}) }}

{{ forms.lightswitchField({
    label: 'Track Server Metrics',
    instructions: 'Periodically sample CPU, memory, disk, and DB metrics.',
    id: 'trackServerMetrics',
    name: 'trackServerMetrics',
    on: settings.trackServerMetrics,
}) }}

{# Deprecated as of 5.1.0 — alert rules are now configurable per-rule. Kept for back-compat with existing config overrides; no longer drives behavior. #}

