{% extends 'control-tower/_cp/_layout' %}

{% block dashboard %}
    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('plugins/save-plugin-settings') }}
        {{ hiddenInput('pluginHandle', 'control-tower') }}

        {# Craft's plugins/save-plugin-settings action reads the `settings` body param.
           The Settings → Plugins screen gets that namespace applied for free by
           `craft\base\Plugin::settingsResponse()`; this page has to apply it itself. #}
        {% namespace 'settings' %}
            {% include 'control-tower/_cp/_settings_fields' %}
        {% endnamespace %}

        <hr>

        <button type="submit" class="btn submit">Save Settings</button>
    </form>
{% endblock %}
