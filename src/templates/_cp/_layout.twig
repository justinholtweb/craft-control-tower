{% extends '_layouts/cp' %}

{% set title = title ?? 'Control Tower' %}
{% set selectedSubnavItem = selectedTab ?? 'overview' %}

{% set ctLicense = craft.app.plugins.getPlugin('control-tower').license %}
{% set ctLicensed = ctLicense.getIsValid() %}

{% set canView = currentUser.can('controltower:viewDashboard') %}
{% set canManageAlerts = currentUser.can('controltower:manageAlerts') %}
{% set canManageSettings = currentUser.can('controltower:manageSettings') %}

{% set tabs = {} %}
{% if not ctLicensed %}
    {# Locked — the license screen is the only page that renders #}
    {% set tabs = { license: { label: 'License', url: cpUrl('control-tower/license') } } %}
{% else %}
    {% if canView %}
        {% set tabs = tabs|merge({
            overview: { label: 'Overview', url: cpUrl('control-tower') },
            visitors: { label: 'Live Traffic', url: cpUrl('control-tower/visitors') },
            editors: { label: 'Editors', url: cpUrl('control-tower/editors') },
            content: { label: 'Content Health', url: cpUrl('control-tower/content') },
            queue: { label: 'Queue Watch', url: cpUrl('control-tower/queue') },
            system: { label: 'System Pulse', url: cpUrl('control-tower/system') },
            alerts: { label: 'Alerts', url: cpUrl('control-tower/alerts') },
        }) %}
    {% endif %}
    {% if canManageAlerts %}
        {% set tabs = tabs|merge({
            rules: { label: 'Alert Rules', url: cpUrl('control-tower/rules') },
            webhooks: { label: 'Webhooks', url: cpUrl('control-tower/webhooks') },
        }) %}
    {% endif %}
    {% if canManageSettings %}
        {% set tabs = tabs|merge({
            license: { label: 'License', url: cpUrl('control-tower/license') },
        }) %}
    {% endif %}
{% endif %}

{% block content %}
    {% if ctLicense.getIsTrial() and ctLicense.getIsEnforced() %}
        <div class="ct-license-banner ct-license-banner--trial">
            <span class="ct-license-banner__label">Trial</span>
            <span>Control Tower is running on a trial license and isn’t licensed for production use yet.</span>
            <a class="ct-license-banner__link" href="{{ cpUrl('control-tower/license') }}">Add a license key</a>
        </div>
    {% endif %}

    <div id="ct-dashboard"
         data-refresh-interval="{{ settings.refreshInterval ?? 30 }}"
         data-tab="{{ selectedTab ?? 'overview' }}">
        <div class="ct-refreshing">
            <span class="ct-refreshing__spinner"></span>
            <span>Refreshing&hellip;</span>
        </div>

        {% block dashboard %}{% endblock %}
    </div>
{% endblock %}
